@@ -0,0 +1,26 @@
+import com.fmp.widget.CountdownTime;
+
+public final class CountdownTest {
+    private static void eq(Object expected,Object found){if(!expected.equals(found))throw new AssertionError(expected+" != "+found);}
+    private static void check(boolean condition,String message){if(!condition)throw new AssertionError(message);}
+    public static void main(String[] args){
+        eq(9*3600_000L+50*60_000L,CountdownTime.remainingFromText("9h 50m"));
+        eq(24*3600_000L+8*3600_000L,CountdownTime.remainingFromText("1j 08h"));
+        eq(2*24*3600_000L+4*3600_000L,CountdownTime.remainingFromText("2j 04h"));
+        eq(-1L,CountdownTime.remainingFromText("vendu"));
+        eq(-1L,CountdownTime.remainingFromText("N/A"));
+        eq(-1L,CountdownTime.remainingFromText("22foo"));
+        eq(-1L,CountdownTime.remainingFromText(""));
+        long start=1_790_000_000_000L;
+        long end=CountdownTime.deadlineAt("9h 50m",start);
+        eq("Fin dans 09h 50m 00s",CountdownTime.remainingLabel("9h 50m",end,start));
+        eq("Fin dans 09h 49m 59s",CountdownTime.remainingLabel("9h 50m",end,start+1000));
+        eq("Échéance estimée atteinte · vérifier FMP",CountdownTime.remainingLabel("9h 50m",end,end));
+        eq(end,CountdownTime.reconcile(end,"9h 49m",start+60_000L));
+        eq(end,CountdownTime.reconcile(end,"9h 50m",start+30_000L));
+        check(CountdownTime.reconcile(end,"10h 50m",start+30_000L)>end,"must reanchor on material auction extension");
+        eq(0L,CountdownTime.reconcile(end,"vendu",start+30_000L));
+        eq("Fin : vendu",CountdownTime.remainingLabel("vendu",0,start));
+        System.out.println("OK: countdown formats, live seconds, OCR reconciliation, sold, expiry");
+    }
+}
