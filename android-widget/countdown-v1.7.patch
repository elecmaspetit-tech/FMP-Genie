+package com.fmp.widget;
+
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Pure time calculation. OCR durations are relative observations, not fixed strings. */
+public final class CountdownTime {
+    private static final Pattern PART = Pattern.compile("(\\d{1,3})(min|[jdhms])");
+    private static final long SECOND=1000L, MINUTE=60*SECOND, HOUR=60*MINUTE, DAY=24*HOUR;
+    private CountdownTime() {}
+
+    /** Returns -1 for an unrecognised/non-time status, otherwise milliseconds remaining. */
+    public static long remainingFromText(String raw) {
+        if (raw==null) return -1;
+        String input=raw.toLowerCase(Locale.ROOT).replaceAll("[\\s\\u00a0]+", "")
+            .replace("fin:", "").replace("fin", "");
+        if (input.isEmpty() || input.equals("n/a") || input.equals("vendu") || input.equals("sold")
+            || input.equals("expire") || input.equals("terminé") || input.equals("termine")) return -1;
+        Matcher m=PART.matcher(input);int index=0;long total=0;boolean matched=false;
+        while(m.find()) {
+            if(m.start()!=index) return -1;
+            index=m.end();matched=true;
+            long v=Long.parseLong(m.group(1));
+            switch(m.group(2)) {
+                case "j":case "d": total+=v*DAY; break;
+                case "h": total+=v*HOUR; break;
+                case "m":case "min": total+=v*MINUTE; break;
+                case "s": total+=v*SECOND; break;
+                default: return -1;
+            }
+        }
+        return matched && index==input.length() ? total : -1;
+    }
+    public static long deadlineAt(String raw,long sampledAt) {
+        long remaining=remainingFromText(raw);
+        return remaining<0 || sampledAt<=0 ? 0 : sampledAt+remaining;
+    }
+    /** Keep a previously estimated end instant when a new OCR reading differs only by rounding. */
+    public static long reconcile(long oldAt,String newRaw,long now) {
+        long remaining=remainingFromText(newRaw);
+        if(remaining<0) return 0;
+        long candidate=now+remaining;
+        if(oldAt<=0) return candidate;
+        String text=newRaw.toLowerCase(Locale.ROOT);
+        long tolerance=text.matches(".*\\d(?:m|min|s).*" ) ? 90*SECOND :
+            text.matches(".*\\d[h].*") ? 70*MINUTE : DAY;
+        return Math.abs(candidate-oldAt)<=tolerance ? oldAt : candidate;
+    }
+    public static String remainingLabel(String original,long deadline,long now) {
+        if(deadline<=0) {
+            if(original==null || original.trim().isEmpty()) return "Fin non relevée";
+            return "Fin : " + original;
+        }
+        long ms=deadline-now;
+        if(ms<=0) return "Échéance estimée atteinte · vérifier FMP";
+        long seconds=(ms+999)/SECOND;
+        long days=seconds/86400;seconds%=86400;
+        long hours=seconds/3600;seconds%=3600;
+        long minutes=seconds/60;seconds%=60;
+        if(days>0)return String.format(Locale.FRANCE,"Fin dans %dj %02dh %02dm %02ds",days,hours,minutes,seconds);
+        if(hours>0)return String.format(Locale.FRANCE,"Fin dans %02dh %02dm %02ds",hours,minutes,seconds);
+        return String.format(Locale.FRANCE,"Fin dans %02dm %02ds",minutes,seconds);
+    }
+}
