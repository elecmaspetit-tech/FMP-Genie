+    /** One inexact, non-wakeup alarm refreshes the widget after the nearest estimated expiry. */
+    public static void scheduleNextExpiry(Context ctx) {
+        long now=System.currentTimeMillis();
+        long next=Long.MAX_VALUE;
+        for(TransferStore.Entry e:TransferStore.all(ctx))
+            if(e.deadlineAt>now && e.deadlineAt<next) next=e.deadlineAt;
+        long previous=ctx.getSharedPreferences(EXPIRY_PREF,Context.MODE_PRIVATE).getLong("next",0);
+        if(next==Long.MAX_VALUE) next=0;
+        if(next==previous)return;
+        AlarmManager manager=(AlarmManager)ctx.getSystemService(Context.ALARM_SERVICE);
+        if(manager==null)return;
+        Intent intent=new Intent(ctx,FavoritesWidget.class).setAction(EXPIRE);
+        PendingIntent alarm=PendingIntent.getBroadcast(ctx,10420,intent,
+            PendingIntent.FLAG_IMMUTABLE|PendingIntent.FLAG_UPDATE_CURRENT);
+        manager.cancel(alarm);
+        if(next>0){
+            manager.set(AlarmManager.ELAPSED_REALTIME,
+                SystemClock.elapsedRealtime()+Math.max(1000,next-now),alarm);
+        }
+        ctx.getSharedPreferences(EXPIRY_PREF,Context.MODE_PRIVATE).edit().putLong("next",next).apply();
+    }
